{:paths ["src/clojure" "src/java" "classes"]

 :mvn/repos {"clojars" {:url "https://repo.clojars.org/"}}

 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        org.apache.lucene/lucene-core {:mvn/version "10.3.2"}
        org.apache.lucene/lucene-analysis-common {:mvn/version "10.3.2"}
        org.apache.lucene/lucene-queryparser {:mvn/version "10.3.2"}
        com.fasterxml.jackson.core/jackson-core {:mvn/version "2.17.2"}
        com.fasterxml.jackson.core/jackson-databind {:mvn/version "2.17.2"}
        org.replikativ/yggdrasil {:mvn/version "0.2.14"}
        ;; Direct now rather than transitive: konserve is the source of truth
        ;; for an index (scriptum.konserve). Content addresses come from
        ;; ContentHash, which is already the function scriptum's merkle commits
        ;; use, so a blob's address is its merkle leaf hash — and it streams.
        ;;
        ;; NOT interchangeable with hasch: both end in SHA-512 -> UUID5, but
        ;; `hasch/uuid` type-tags its input first, so the two produce DIFFERENT
        ;; addresses for the same bytes. Only relevant if a store written by an
        ;; earlier draft of scriptum.konserve is reused — a re-synced segment
        ;; would land under a second address and stop sharing. The manifest
        ;; carries no format version to detect that; the namespace is
        ;; unreleased, so no migration is provided.
        org.replikativ/konserve {:mvn/version "0.9.350"}}

 :aliases
 {;; Sibling checkouts, for co-development across the replikativ stack.
  ;; scriptum.konserve needs konserve.gc-guard, which is unreleased — use this
  ;; alias until a konserve carrying it is on Maven.
  :local
  {:override-deps {org.replikativ/konserve {:local/root "../konserve"}}}

  :build
  {:deps {io.github.clojure/tools.build {:mvn/version "0.10.6"}
          slipset/deps-deploy {:mvn/version "0.2.0"}}
   :ns-default build}

  :test
  {:extra-paths ["test"]
   :extra-deps {io.github.cognitect-labs/test-runner
                {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                org.replikativ/hasch {:mvn/version "0.3.96"}}
   :main-opts ["-m" "cognitect.test-runner"]}

  ;; Lucene's own Directory conformance suite. `BaseDirectoryTestCase` is what
  ;; MMapDirectory is held to; running scriptum's Directories against it is how
  ;; we know they are Directories and not merely enough of one for the code path
  ;; Lucene happens to take. Compile with `clj -T:build compile-tck`, then:
  ;;   clj -M:local:tck -m scriptum.tck-runner
  ;; `:local` is required until a konserve carrying gc-guard is released — see
  ;; the alias above and scriptum.tck-runner's docstring.
  :tck
  {:extra-paths ["test" "target/test-classes"]
   :extra-deps {org.apache.lucene/lucene-test-framework {:mvn/version "10.3.2"}}
   :jvm-opts ["--enable-native-access=ALL-UNNAMED" "-ea"]}

  :format
  {:extra-deps {cljfmt/cljfmt {:mvn/version "0.9.2"}}
   :main-opts ["-m" "cljfmt.main" "check"]}

  :ffix
  {:extra-deps {cljfmt/cljfmt {:mvn/version "0.9.2"}}
   :main-opts ["-m" "cljfmt.main" "fix"]}

  :repl
  {:extra-deps {nrepl/nrepl {:mvn/version "1.3.0"}
                cider/cider-nrepl {:mvn/version "0.50.2"}}
   :jvm-opts ["--enable-native-access=ALL-UNNAMED"]
   :main-opts ["-m" "nrepl.cmdline" "--middleware"
               "[cider.nrepl/cider-middleware]"]}

  :datahike-experiment
  {:extra-paths ["dev"]
   :extra-deps {io.replikativ/datahike {:local/root "../datahike"}
                nrepl/nrepl {:mvn/version "1.3.0"}
                cider/cider-nrepl {:mvn/version "0.50.2"}}
   :jvm-opts ["--enable-native-access=ALL-UNNAMED"]
   :main-opts ["-m" "nrepl.cmdline" "--middleware"
               "[cider.nrepl/cider-middleware]"]}}}
